# ============================================================================
# AEGIS-X Cyber Exposure & Risk Intelligence Platform Configuration
# ============================================================================

# Database Configuration
DATABASE_URL=sqlite:///./aegis_x.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://aegis_user:secure_password@postgres:5432/aegis_x

# JWT & API Secrets
SECRET_KEY=change_this_to_a_cryptographically_random_256_bit_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform URL
AEGIS_PUBLIC_URL=http://localhost:8000

# ============================================================================
# AEGIS-X Secure Incident Messaging (Matrix + Synapse E2EE)
# ============================================================================
AEGIS_MESSAGING_ENABLED=true
MATRIX_HOMESERVER_URL=https://chat.aegis-x.internal
MATRIX_SERVER_NAME=chat.aegis-x.internal
MESSAGING_ALLOW_CROSS_TENANT=false
MESSAGING_REQUIRE_DEVICE_VERIFICATION=true
MESSAGING_POLICY_VERSION=messaging-policy-v1

# Matrix Synapse Deployment Secrets (Used in deploy/compose.yaml)
SYNAPSE_POSTGRES_USER=synapse_user
SYNAPSE_POSTGRES_PASSWORD=synapse_secure_db_pass_2026
SYNAPSE_REGISTRATION_SECRET=aegis_x_synapse_reg_secret_change_in_prod
